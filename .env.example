# Copy to .env and fill in. All values here are Supabase publishable
# (anon) credentials - they ship to the browser via the VITE_ prefix
# and are protected by row level security. Never add a service-role
# key or any other secret to this file or to .env.

SUPABASE_PROJECT_ID=your-value-here
SUPABASE_PUBLISHABLE_KEY=your-value-here
SUPABASE_URL=your-value-here
VITE_SUPABASE_PROJECT_ID=your-value-here
VITE_SUPABASE_PUBLISHABLE_KEY=your-value-here
VITE_SUPABASE_URL=your-value-here
